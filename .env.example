PORT=8081
NODE_ENV=development
DATABASE_PATH=./data/citadels.sqlite
JWT_SECRET=change-me-to-a-long-random-string
# Production: comma-separated allowed origins, or the public URL of the site.
CORS_ORIGIN=http://localhost:8081
# Set to 1 only when TLS is terminated at Node directly. Behind Nginx/Caddy leave 0
# and let the reverse proxy handle the 80 -> 443 redirect.
ENFORCE_HTTPS=0
