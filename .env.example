PORT=8081
NODE_ENV=development
DATABASE_PATH=./data/citadels.sqlite
JWT_SECRET=change-me-to-a-long-random-string
# Production: comma-separated allowed origins, or the public URL of the site.
CORS_ORIGIN=http://localhost:8081
# Set to 1 only when TLS is terminated at Node directly. Behind Nginx/Caddy leave 0
# and let the reverse proxy handle the 80 -> 443 redirect.
ENFORCE_HTTPS=0

# ── Admin management API ──────────────────────────────────────────────────
# Both must be set or the whole /api/admin surface stays disabled (404).
# Access pattern: SSH tunnel `ssh -L 8081:127.0.0.1:8081 user@vps` then open
# http://127.0.0.1:8081/admin locally — the tunnel lands as 127.0.0.1.
# ADMIN_TOKEN: >=32 char random string, e.g. `openssl rand -hex 32`.
#              Independent from JWT_SECRET; a leaked player token cannot escalate.
# ADMIN_ALLOW_IPS: comma-separated TCP peer IPs allowed to reach admin.
#                  Uses the real socket peer (not X-Forwarded-For), so behind
#                  Nginx only the loopback tunnel qualifies. Leave empty to disable.
# ADMIN_TOKEN=
# ADMIN_ALLOW_IPS=127.0.0.1,::1

